{
  "name": "vol-surface-cinema",
  "private": true,
  "version": "0.1.0",
  "description": "An animated 3D implied-volatility surface that plays date by date, with deterministic GIF/MP4 export",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:data": "node scripts/generate-synthetic.ts",
    "import:real": "node scripts/import-backtester-frames.ts",
    "export": "npm run build && node scripts/export.ts",
    "screenshots": "npm run build && node scripts/screenshots.ts",
    "test:e2e": "npm run build && node tests/e2e/export.smoke.ts",
    "test:py": "uv run --locked pytest tools/blender",
    "verify": "npm test && npm run build && npm run test:py"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "jsdom": "26.1.0",
    "playwright": "1.62.0",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
